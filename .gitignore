# Стенд воркшопа Agentic Bitrix — репозиторий лежит в корне сайта Omut (~/Omut/workshop.bitrix/).
# Трекаем только пользовательский код и материалы занятий. Ядро, БД, зависимости — нет.

# Публичная часть: всё, кроме /local/
/www/*
!/www/local/
/www/local/php_interface/dbconn.php
/www/local/.settings_extra.php

# Зависимости
/vendor/
/node_modules/

# Артефакты npx skills (нужны только .agents/skills и skills-lock.json):
# симлинки пака в .claude/skills. Проектные скиллы и агенты в .claude/ трекаем.
/agent/
/.claude/skills/bitrix-*

# Claude Code: личные настройки и рабочие копии
/.claude/settings.local.json
/.claude/worktrees/

# Служебное
.DS_Store
.idea/
*.log