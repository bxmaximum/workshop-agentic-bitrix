# Скопируй в config/farm.env (в .gitignore) и поправь при необходимости. Без файла работают значения по умолчанию.

FARM_MODEL=claude-opus-5-5        # чат и маршрутизация
FARM_EFFORT=low                   # low | medium | high | xhigh | max
FARM_TASK_MODEL=claude-opus-5-5   # вложенный агент в репозитории проекта
FARM_TASK_EFFORT=xhigh
FARM_MAX_TURNS=200                # страховка от зацикливания вложенного агента
FARM_WEB_PORT=4420                # веб-интерфейс http://localhost:4420
FARM_REMOTE_CONTROL=0             # 1 — сессия видна в приложении claude.ai на телефоне

# Telegram настраивается один раз в самой сессии, не здесь:
#   claude plugin install telegram@claude-plugins-official
#   /telegram:configure <token от BotFather>
#   написать боту → получить код → /telegram:access pair <код> → /telegram:access policy allowlist
